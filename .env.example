# Root environment file — read by Docker Compose for LOCAL DEVELOPMENT ONLY.
# Create your copy with:  pnpm env:init   (or: cp .env.example .env)
# Real .env files are git-ignored. Never commit real credentials.

# PostgreSQL + PostGIS container
POSTGRES_DB=vtp_dev
POSTGRES_USER=vtp
# SECRET — placeholder for local use. Must match DATABASE_PASSWORD in apps/api/.env.
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_PORT=5432

# Optional Redis container (only started with: pnpm infra:up:redis)
REDIS_PORT=6379

# ---- Running the API and website in Docker (pnpm stack:api / pnpm stack:app) ----
# Host ports. Change them if 4000 or 3000 are taken (then also adjust the URLs below).
VTP_API_PORT=4000
VTP_WEB_PORT=3000
# 127.0.0.1 keeps the API private to this computer. 0.0.0.0 lets a phone on your Wi-Fi reach
# it (trusted networks only); then use http://<your-LAN-IP>:4000/api/v1 in the mobile apps.
VTP_API_PUBLISH_ADDRESS=127.0.0.1
# Where the BROWSER finds the API (baked into the website image; rebuild after changing it).
VTP_WEB_PUBLIC_API_BASE_URL=http://localhost:4000/api/v1
# SECRET — placeholder for local use only. Optional; the default works locally.
# VTP_AUTH_SECRET=
# smtp sends the API container's e-mail to Mailpit (pnpm infra:up:mail, read at :8025).
# VTP_MAIL_DELIVERY=console
# Host ports for Mailpit (SMTP, web).
# MAILPIT_SMTP_PORT=1025
# MAILPIT_WEB_PORT=8025
