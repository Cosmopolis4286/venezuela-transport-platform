# API runtime configuration. Copy to apps/api/.env (git-ignored) and adjust.
# Every value here is validated at startup by src/config/env.schema.ts.

NODE_ENV=development
# Reported by GET /api/v1/health. Set to the release tag or git SHA when deploying.
APP_VERSION=0.0.0-dev
API_HOST=127.0.0.1
API_PORT=4000
# Comma-separated list of allowed browser origins. Never use * in production.
# 8081/8082 are the browser previews of the mobile apps (see docs/architecture/mobile-apps.md).
CORS_ORIGINS=http://localhost:3000,http://localhost:8081,http://localhost:8082
# Reverse-proxy hops in front of the API (0 locally, usually 1 behind Caddy/Nginx).
API_TRUST_PROXY_HOPS=0
# Global per-IP rate limit: RATE_LIMIT_MAX requests per RATE_LIMIT_TTL_SECONDS.
RATE_LIMIT_TTL_SECONDS=60
RATE_LIMIT_MAX=120
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
SWAGGER_ENABLED=true

# PostgreSQL / PostGIS. Must match the values in the root .env used by Docker Compose.
DATABASE_HOST=127.0.0.1
DATABASE_PORT=5432
DATABASE_NAME=vtp_dev
DATABASE_USER=vtp
# SECRET — local placeholder only. Use a strong unique value anywhere else.
DATABASE_PASSWORD=change-me-local-only
DATABASE_SSL=false
DATABASE_POOL_MAX=10

# Authentication. SECRET — HMAC key for token and OTP hashes (32+ chars). Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=change-me-local-only-dev-secret-0123456789
AUTH_ACCESS_TOKEN_TTL_MINUTES=15
AUTH_REFRESH_TOKEN_TTL_DAYS=30
# Per-IP requests per minute to login/register/OTP endpoints.
AUTH_RATE_LIMIT_MAX=10
# One-time codes: console (prints codes to the API log; development only) | email (sends e-mail
# codes with the mailer below; SMS/WhatsApp codes answer 503) | disabled
OTP_DELIVERY=console
OTP_TTL_MINUTES=5
OTP_MAX_ATTEMPTS=5
OTP_RESEND_SECONDS=60
OTP_MAX_PER_HOUR=5

# KYC document storage. Files are private: they are only served through authenticated API routes.
FILE_STORAGE_DRIVER=local
FILE_STORAGE_LOCAL_DIR=var/uploads
# 10 MiB
FILE_UPLOAD_MAX_BYTES=10485760
# Minutes held seats wait for payment before they are released (5–60).
BOOKING_HOLD_MINUTES=15
# Who confirms payments: simulated (fake accounts, development only) or disabled. Leave empty for
# the default: simulated outside production, disabled in production.
PAYMENT_PROVIDER=

# E-mail: console (logs it; development only) | smtp | disabled. Empty: console outside
# production, disabled in production. With Mailpit (pnpm infra:up:mail): smtp, localhost, 1025.
MAIL_DELIVERY=
SMTP_HOST=
SMTP_PORT=587
# true for implicit TLS (port 465)
SMTP_SECURE=false
SMTP_USER=
# Secret: set it only in your local .env or the server's environment, never in git.
SMTP_PASSWORD=
MAIL_FROM=VTP <no-reply@localhost>

# Push notifications: console (logs them; development only) | expo | disabled. Empty: console
# outside production, disabled in production.
PUSH_DELIVERY=
# Optional secret, only if "enhanced push security" is on in the Expo project.
EXPO_ACCESS_TOKEN=
# Hours before boarding for the trip reminder (0 turns reminders off).
TRIP_REMINDER_HOURS=3

# Optional. Leave empty unless a feature that needs Redis/BullMQ is enabled.
REDIS_URL=
