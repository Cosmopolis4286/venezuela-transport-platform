{
  "name": "@vtp/api",
  "version": "0.0.1",
  "private": true,
  "description": "NestJS modular-monolith REST API.",
  "license": "UNLICENSED",
  "type": "module",
  "files": [
    "dist",
    "drizzle",
    "scripts"
  ],
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch --preserveWatchOutput",
    "start": "node --enable-source-maps dist/main.js",
    "start:debug": "nest start --debug --watch",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:e2e": "vitest run --config ./vitest.config.e2e.ts",
    "db:check": "node --env-file-if-exists=.env scripts/db-check.mjs",
    "clean": "rm -rf dist coverage .turbo",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "nest build && node --env-file-if-exists=.env dist/database/migrate.js",
    "platform:grant": "nest build && node --env-file-if-exists=.env dist/cli/platform-grant.js"
  },
  "dependencies": {
    "@nestjs/common": "12.1.3",
    "@nestjs/config": "12.0.1",
    "@nestjs/core": "12.1.3",
    "@nestjs/platform-express": "12.3.2",
    "@nestjs/swagger": "12.0.4",
    "@nestjs/throttler": "6.7.1",
    "@vtp/shared-types": "workspace:*",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "drizzle-orm": "0.45.4",
    "helmet": "8.3.0",
    "libphonenumber-js": "1.13.15",
    "multer": "2.5.0",
    "nestjs-pino": "5.3.1",
    "pg": "8.23.1",
    "pino": "10.4.0",
    "pino-http": "11.0.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@nestjs/cli": "12.0.10",
    "@nestjs/schematics": "12.0.10",
    "@nestjs/testing": "12.2.0",
    "@types/express": "5.0.6",
    "@types/multer": "2.3.0",
    "@types/node": "catalog:",
    "@types/pg": "8.23.1",
    "@types/supertest": "7.2.1",
    "@vitest/coverage-v8": "catalog:",
    "@vtp/eslint-config": "workspace:*",
    "@vtp/typescript-config": "workspace:*",
    "drizzle-kit": "0.31.11",
    "eslint": "catalog:",
    "pino-pretty": "13.2.0",
    "supertest": "7.3.1",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
