# Copy to .env in this app directory (git-ignored).
#
# WARNING: EXPO_PUBLIC_* variables are embedded in the app bundle and can be read by
# anyone who installs the app. They are configuration, NOT secret storage.
#
# Android emulator: use http://10.0.2.2:4000/api/v1
# Physical device:  use http://<your-computer-LAN-IP>:4000/api/v1 and set API_HOST=0.0.0.0 in apps/api/.env
EXPO_PUBLIC_API_BASE_URL=http://localhost:4000/api/v1
