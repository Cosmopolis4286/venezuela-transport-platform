{
  "name": "@vtp/passenger-mobile",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "dev": "expo start --port 8081",
    "android": "expo start --port 8081 --android",
    "ios": "expo start --port 8081 --ios",
    "export": "expo export --platform android --platform ios --output-dir dist",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "jest --passWithNoTests=false",
    "doctor": "npx expo-doctor@latest",
    "clean": "rm -rf .expo dist .turbo"
  },
  "dependencies": {
    "@vtp/mobile-core": "workspace:*",
    "@vtp/shared-types": "workspace:*",
    "expo": "~58.0.14",
    "expo-constants": "~58.0.12",
    "expo-linking": "~58.0.13",
    "expo-router": "~58.0.23",
    "expo-secure-store": "~58.0.2",
    "expo-status-bar": "~58.0.3",
    "qrcode-generator": "2.0.4",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-native": "0.88.0",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-web": "~0.21.4"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/react": "catalog:",
    "@vtp/eslint-config": "workspace:*",
    "eslint": "catalog:",
    "eslint-config-expo": "~58.0.4",
    "jest": "^30.5.2",
    "jest-expo": "~58.0.11",
    "typescript": "catalog:"
  },
  "jest": {
    "preset": "jest-expo",
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/dist/"
    ]
  }
}
