# Web app configuration. Copy to apps/web/.env.local (git-ignored).
#
# WARNING: every NEXT_PUBLIC_* variable is inlined into the JavaScript sent to browsers.
# Never put secrets in a NEXT_PUBLIC_* variable.

# Public base URL of the REST API (no trailing slash).
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000/api/v1

# Server only. How many reverse proxies (Caddy, Nginx) stand in front of the web server: it then
# passes the visitor's IP to the API so per-IP limits count each visitor. 0 (default) in development;
# 1 behind one Caddy. Never more than the real proxies, or visitors could fake their address.
# WEB_TRUST_PROXY_HOPS=0
