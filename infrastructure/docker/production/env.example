# Copy each block into its own file under /etc/vtp. Never commit real values.
# Protect all files with root:root and chmod 600.

# ---- /etc/vtp/compose.env (non-secret Compose interpolation) ----
VTP_WEB_DOMAIN=app.example.ve
VTP_API_DOMAIN=api.example.ve
VTP_ACME_EMAIL=ops@example.ve
VTP_API_IMAGE=ghcr.io/OWNER/vtp-api:GIT_SHA
VTP_WEB_IMAGE=ghcr.io/OWNER/vtp-web:GIT_SHA

# ---- /etc/vtp/postgres.env (database bootstrap secrets) ----
POSTGRES_DB=vtp
POSTGRES_USER=vtp_owner
POSTGRES_PASSWORD=REPLACE_WITH_OWNER_PASSWORD
VTP_APP_DB_USER=vtp_app
VTP_APP_DB_PASSWORD=REPLACE_WITH_APP_PASSWORD

# ---- /etc/vtp/migrate.env (owner role; schema migrations only) ----
DATABASE_PORT=5432
DATABASE_NAME=vtp
DATABASE_USER=vtp_owner
DATABASE_PASSWORD=REPLACE_WITH_OWNER_PASSWORD
DATABASE_SSL=false

# ---- /etc/vtp/api.env (least-privilege runtime role) ----
APP_VERSION=GIT_SHA
CORS_ORIGINS=https://app.example.ve
LOG_LEVEL=info
SWAGGER_ENABLED=false
DATABASE_PORT=5432
DATABASE_NAME=vtp
DATABASE_USER=vtp_app
DATABASE_PASSWORD=REPLACE_WITH_APP_PASSWORD
DATABASE_SSL=false
RATE_LIMIT_TTL_SECONDS=60
RATE_LIMIT_MAX=120
AUTH_SECRET=REPLACE_WITH_64_HEX_CHARS
AUTH_RATE_LIMIT_MAX=10
PAYMENT_PROVIDER=manual
INVOICE_ISSUER=draft
# Public support WhatsApp (international number); empty hides the button.
SUPPORT_WHATSAPP=
OTP_DELIVERY=disabled
MAIL_DELIVERY=disabled
PUSH_DELIVERY=disabled
# Enable OTP email only after configuring a verified SMTP provider:
# OTP_DELIVERY=email
# MAIL_DELIVERY=smtp
# SMTP_HOST=smtp.example.ve
# SMTP_PORT=587
# SMTP_USER=REPLACE
# SMTP_PASSWORD=REPLACE
# MAIL_FROM=VTP <no-reply@example.ve>
# Enable Expo push only after configuring production EAS:
# PUSH_DELIVERY=expo
# EXPO_ACCESS_TOKEN=REPLACE
