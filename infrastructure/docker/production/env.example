# Templates for the production env files referenced by compose.yml. Copy each block to its
# own file on the server (outside the repo), e.g. /etc/vtp/compose.env, /etc/vtp/api.env,
# /etc/vtp/postgres.env — owned by root, chmod 600. Replace EVERY value.

# ---- /etc/vtp/compose.env (variables interpolated into compose.yml; not secret) ----
VTP_WEB_DOMAIN=app.example.ve
VTP_API_DOMAIN=api.example.ve
VTP_ACME_EMAIL=ops@example.ve
VTP_API_IMAGE=ghcr.io/OWNER/vtp-api:GIT_SHA
VTP_WEB_IMAGE=ghcr.io/OWNER/vtp-web:GIT_SHA

# ---- /etc/vtp/postgres.env (SECRET) ----
POSTGRES_DB=vtp
POSTGRES_USER=vtp_owner
POSTGRES_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_VALUE

# ---- /etc/vtp/api.env (SECRET) ----
APP_VERSION=GIT_SHA
CORS_ORIGINS=https://app.example.ve
LOG_LEVEL=info
SWAGGER_ENABLED=false
DATABASE_PORT=5432
DATABASE_NAME=vtp
DATABASE_USER=vtp_owner
DATABASE_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_VALUE
DATABASE_SSL=false
RATE_LIMIT_TTL_SECONDS=60
RATE_LIMIT_MAX=120
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=REPLACE_WITH_64_HEX_CHARS
AUTH_RATE_LIMIT_MAX=10
# Sign-in codes by e-mail need a real SMTP account (SMS/WhatsApp are not integrated).
OTP_DELIVERY=disabled
# MAIL_DELIVERY=smtp
# SMTP_HOST=smtp.example.ve
# SMTP_PORT=587
# SMTP_USER=REPLACE
# SMTP_PASSWORD=REPLACE
# MAIL_FROM=VTP <no-reply@example.ve>
# PUSH_DELIVERY=expo
