{
  "name": "@vtp/mobile-core",
  "version": "0.0.0",
  "private": true,
  "description": "Session handling, API client and sign-in screens shared by the two Expo apps. Consumed as TypeScript source by Metro.",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts"
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "clean": "rm -rf .turbo"
  },
  "peerDependencies": {
    "@vtp/shared-types": "workspace:*",
    "expo-constants": "*",
    "expo-localization": "*",
    "expo-notifications": "*",
    "expo-secure-store": "*",
    "react": "*",
    "react-native": "*",
    "react-native-safe-area-context": "*"
  },
  "devDependencies": {
    "@types/react": "catalog:",
    "@vtp/eslint-config": "workspace:*",
    "@vtp/shared-types": "workspace:*",
    "eslint": "catalog:",
    "eslint-config-expo": "~58.0.4",
    "expo-constants": "~58.0.13",
    "expo-localization": "~58.0.5",
    "expo-notifications": "~58.1.7",
    "expo-secure-store": "~58.0.2",
    "react": "catalog:",
    "react-native": "0.88.0",
    "react-native-safe-area-context": "~5.10.1",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
